93 פָּגַע","Isaías 53:6 (o versículo)"]]],"7":[[134,146,"v:tosquiar","H1494"]],"8":[[110,118,"v:vivente","H2416"]],"10":[[71,75,"v:alma","H5315"],[91,109,"H817","Asham significa culpa e também oferta pela culpa ou pelo pecado. Aqui a alma do Servo é posta como expiação do pecado: ele mesmo é a oferta.",["Léxico de Strong; glosa STEPBible (CC BY) — H817 אָשָׁם","Isaías 53:10 (o versículo)"]]],"11":[[53,60,"v:fartar","H7646"],[105,116,"H6663","Justificar. O Servo justo justificará a muitos, pois levará sobre si as perversidades deles. Paulo diz que Cristo foi feito pecado por nós, para sermos feitos justiça de Deus nele (2 Coríntios 5:21).",["Léxico de Strong; glosa STEPBible (CC BY) — H6663 צָדַק","Isaías 53:11 (o versículo)","2 Coríntios 5:21"]]],"12":[[74,81,"v:despojo","H7998"]]},"54":{"1":[[83,89,"v:jubilar","H7442"]],"3":[[111,120,"v:assolacao","H8074"]],"5":[[70,75,"H6918"],[94,102,"H1350"]],"7":[[50,63,"H7356"]],"8":[[69,76,"H2617"]],"10":[[99,104,"H1285"]],"11":[[14,22,"v:afligir","H6041"],[120,127,"v:pedra-preciosa"]],"14":[[94,102,"v:assombro"]],"16":[[19,24,"H1254"]]},"55":{"2":[[155,159,"v:alma","H5315"],[163,170,"v:deleitar","H6026"]],"3":[[0,8,"v:inclinar","H5186"],[92,97,"H1285"],[125,133,"H2617"]],"4":[[53,61,"v:principe","H5057"]],"5":[[132,137,"H6918"]],"13":[[76,81,"v:murta","H1918"]]},"56":{"1":[[78,86,"H3444"]],"2":[[0,14,"H835"],[43,57,"v:filho-do-homem-mortal","H120"],[102,110,"v:profano","H2490"]],"3":[[130,136,"v:eunuco","H5631"]],"4":[[124,129,"H1285"]],"8":[[81,90,"v:ajuntar","H6908"]]},"57":{"1":[[8,14,"v:perecer","H6"]],"3":[[31,39,"v:adivinhacao"]],"4":[[25,33,"v:escarnio"],[124,136,"H6588"]],"5":[[121,127,"v:fender"]],"6":[[21,29,"v:ribeiro","H5158"]],"8":[[27,34,"v:umbral","H4201"]],"9":[[114,130,"H7585"]],"13":[[19,25,"v:clamar","H2199"],[105,110,"H1892"],[114,124,"v:arrebatar"]],"14":[[60,68,"v:tropeco","H4383"]],"15":[[75,80,"H6918"],[166,175,"v:vivificar","H2421"]],"17":[[5,12,"H5771"],[20,26,"v:cobicar"]],"19":[[3,7,"H1254"]],"20"